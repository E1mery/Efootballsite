# Database Connection URL (PostgreSQL / Supabase / Neon / Local)
DATABASE_URL="postgresql://username:password@localhost:5432/efootball_db?schema=public"

# Application Branding
NEXT_PUBLIC_APP_NAME="eFootball Rwanda League"
NEXT_PUBLIC_APP_DESCRIPTION="The Premier Competitive eFootball Esports Tournament in Rwanda"

# Cloudflare R2 Object Storage / S3-compatible Credentials
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="efootball-rwanda-league-proofs"
