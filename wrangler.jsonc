{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efootball-rwanda-league",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "efrl-db",
      "database_id": "ad99673d-d023-4973-90fc-6500cab0a81b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "rwandafootballleague"
    }
  ],
  "triggers": {
    "crons": [
      "0 21 * * *",
      "0 22 * * *"
    ]
  }
}
